# Copy this file to .env and fill in your own values.
# Never commit the real .env file (it should be in .gitignore).

# -----------------------------------------------------------------
# Scraping (scrapper.py, main.py) — LLM-based landing-page extraction
# -----------------------------------------------------------------
# Groq API key, used by crawl4ai's LLMExtractionStrategy to parse article
# listings off each source's landing page (llama-3.3-70b-versatile /
# llama-3.1-8b-instant, with automatic retry/fallback between them).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# -----------------------------------------------------------------
# ReAct Judge (judge_agent.py, judge_tools.py) — article evaluation
# -----------------------------------------------------------------
# Ollama Cloud API key, used to run the ReAct judge agent's model
# (gpt-oss:120b-cloud by default — see MODEL_REGISTRY in judge_agent.py).
# Get one at https://ollama.com
OLLAMA_API_KEY=

# Tavily Search API key. Used two places:
#   1. judge_tools.search_web_verification — the judge tool that verifies
#      factual claims, version numbers, and benchmark results in an article.
#   2. (if/when added) live news discovery via Tavily's "news" search.
# Get one at https://tavily.com
TAVILY_API_KEY=

# -----------------------------------------------------------------
# Storage (database.py, embeddings.py) — Neon Postgres + pgvector
# -----------------------------------------------------------------
# Full connection string from your Neon project dashboard
# (Connect > Connection string). Must include sslmode=require.
# Used for article deduplication (URL / content hash / vector similarity)
# and persistence of judged articles.
NEON_DATABASE_URL=

# -----------------------------------------------------------------
# Optional — LangSmith tracing for the judge agent
# -----------------------------------------------------------------
# Not currently read by any file in this project. LangChain will pick
# these up automatically if you set them and want to trace/debug the
# ReAct judge agent's runs at https://smith.langchain.com — otherwise
# leave unset.
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=Tech_News_AI